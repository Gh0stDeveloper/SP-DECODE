{
  "openapi": "3.1.0",
  "info": {
    "title": "SP-DECODE Cloud API — C3 gated security contract",
    "version": "0.3.0",
    "description": "Gated by CLOUD_API_ENABLED plus server-side Google Play Integrity/Redis and private worker credentials. Without complete configuration all decoding and session operations return 503; Android transport libspdecode.so follows in C4."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local development only; production requires HTTPS"
    }
  ],
