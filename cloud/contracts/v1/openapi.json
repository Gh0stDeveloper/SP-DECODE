    "/api/v1/health": {
      "get": {
        "summary": "Liveness (no decoder readiness implied)",
        "responses": {
          "200": {
            "description": "Process alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiVersion",
                    "status"
                  ],
                  "properties": {
                    "apiVersion": {
                      "type": "string",
                      "const": "v1"
                    },
                    "status": {
                      "type": "string",
                      "const": "alive"
                    },
                    "service": {
                      "type": "string"
                    },
                    "phase": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "summary": "Cloud readiness (503 until C2/C3)",
        "responses": {
          "200": {
            "description": "Authenticated operation completed"
          },
          "503": {
            "description": "Sanitized JSON error, including disabled/unavailable service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorReply"
                }
              }
            }
          }
        },
        "description": "C3 gate is disabled by default; success only after Play Integrity admission, Redis checks and private worker readiness."
      }
    },
