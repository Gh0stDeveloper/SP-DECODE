# SP-DECODE C3: example variable names only. Never commit values.
NODE_ENV=development
WORKER_INTERNAL_URL=http://decoder-worker:8787
CLOUD_API_ENABLED=false
CLOUD_TRUST_PROXY=false
CLOUD_REDIS_URL=redis://redis:6379
# Required to enable on a hardened HTTPS + trusted reverse-proxy deployment:
# CLOUD_WORKER_TOKEN=<at-least-32-random-characters>
# CLOUD_SESSION_SIGNING_KEY=<at-least-32-random-characters>
# CLOUD_GOOGLE_PLAY_PACKAGE=com.ghostdeveloper.spdecode
# CLOUD_GOOGLE_SERVICE_ACCOUNT_JSON=<server-side Google service account JSON>
# CLOUD_REQUIRE_LICENSED=true
# CLOUD_REQUIRE_STRONG_INTEGRITY=false
# Do not store any secret in NEXT_PUBLIC_*, Kotlin, assets or libspdecode.so.

# C3.5 remote provider broker: SERVER-ONLY controls; disabled by default.
CLOUD_EHI_IMPORT_ENABLED=false
# CLOUD_EHI_SIGN_KEY=<provision-only-on-server; provider protocol signing key>
# CLOUD_EHI_RESPONSE_KEY=<provision-only-on-server; provider response key>
CLOUD_NUR_FETCH_ENABLED=false
# CLOUD_NUR_CATALOG_URL=<exact current HTTPS catalog URL on strongteam.co>
# Never accept arbitrary download destinations supplied by Android clients.

# C6 website. Indexing remains off until official public release.
CLOUD_PUBLIC_SITE_INDEX=false

# C6 private admin; all disabled by default. Set server-side only.
CLOUD_ADMIN_ENABLED=false
CLOUD_FORCE_MAINTENANCE=false
# CLOUD_ADMIN_PUBLIC_ORIGIN=https://your-actual-domain.example
# CLOUD_ADMIN_SESSION_KEY=<different-random-secret-at-least-32-chars>
# CLOUD_ADMIN_PASSWORD_SCRYPT=<hash-generated-with-scripts/hash-admin-password.mjs>
# Admin requires CLOUD_TRUST_PROXY=true and a real trusted HTTPS reverse proxy.
# Redis maintenance flag is volatile; CLOUD_FORCE_MAINTENANCE can provide an
# externally managed deployment-time hard stop that the panel cannot override.
