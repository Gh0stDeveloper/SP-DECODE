#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ROOT="${SPDECODE_HOME:-/opt/spdecode}"
CFG="${SPDECODE_CONFIG_DIR:-/etc/spdecode}"
REPO="$ROOT/repo"; ENVFILE="$CFG/cloud.env"; CONF="$CFG/install.conf"
die(){ echo "ERROR: $*" >&2; exit 1; }
log(){ echo "[spdecode] $*"; }
[[ $(id -u) -eq 0 ]] || die "Run via sudo"
[[ -f "$CONF" && -f "$ENVFILE" && -d "$REPO/.git" ]] || die "Run VPS installer first"
[[ $(stat -c %a "$CONF") == 600 && $(stat -c %a "$ENVFILE") == 600 ]] || die "Unsafe configuration permissions"
# shellcheck source=/dev/null
source "$CONF"
[[ "$SPDECODE_REPO_URL" == "https://github.com/Gh0stDeveloper/SP-DECODE.git" ||
   "$SPDECODE_REPO_URL" == "git@github.com:Gh0stDeveloper/SP-DECODE.git" ]] || die "Untrusted repo"
mkdir -p "$ROOT"; exec 9>"$ROOT/.operator.lock"; flock -x 9
compose(){ docker compose --project-name spdecode --env-file "$ENVFILE" -f "$REPO/cloud/compose.yaml" "$@"; }
preflight(){ command -v docker >/dev/null && docker compose version >/dev/null || die "Docker Compose v2 required"; }
health(){
  for i in $(seq 1 20); do
    curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:3000/api/v1/health >/dev/null && return 0
    sleep 3
  done
  return 1
}
clean_repo(){ [[ -z $(git -C "$REPO" status --porcelain) ]] || die "Uncommitted source changes; refusing reset"; }
sync_ref(){
  local ref="$1" old next
  [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ && "$ref" != -* && "$ref" != *..* &&
     "$ref" != /* && "$ref" != */ ]] || die "Invalid Git ref"
  clean_repo
  git -C "$REPO" fetch --no-tags origin "$ref"
  next=$(git -C "$REPO" rev-parse 'FETCH_HEAD^{commit}')
  old=$(git -C "$REPO" rev-parse HEAD)
  [[ "$next" =~ ^[0-9a-f]{40}$ ]] || die "Invalid fetched commit"
  printf '%s\n' "$old" > "$ROOT/previous.sha"
  git -C "$REPO" reset --hard "$next" >/dev/null
  log "Previous $old; new $next"
}
deploy(){
  local kind="$1"
  case "$kind" in
    api|web|panel)
      log "API, web and admin panel are a single Next.js service"
      compose build web
      compose up -d --no-deps web
      health || die "Web health check failed"
      ;;
    worker|engines)
      compose build decoder-worker
      compose up -d --no-deps decoder-worker
      compose exec -T decoder-worker python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8787/health',timeout=4)"
      ;;
    all)
      compose build decoder-worker web
      compose up -d --no-deps decoder-worker
      compose up -d --no-deps web
      health || die "Web health check failed"
      ;;
    *) die "Expected api|web|panel|worker|all";;
  esac
}
update(){
  local kind="$1" ref="$2"
  preflight
  [[ "$kind" =~ ^(api|web|panel|worker|engines|all)$ ]] || die "Bad component"
  sync_ref "$ref"
  if ! (deploy "$kind"); then
    log "Deployment failed; restoring previous source and rebuilding"
    git -C "$REPO" reset --hard "$(cat "$ROOT/previous.sha")" >/dev/null
    (deploy "$kind") || log "ALERT: rollback failed, manual inspection required"
    return 1
  fi
  compose ps
}
set_env(){
  local key="$1" value="$2"
  case "$key" in
    CLOUD_API_ENABLED|CLOUD_ADMIN_ENABLED|CLOUD_FORCE_MAINTENANCE|CLOUD_PUBLIC_SITE_INDEX)
      [[ "$value" == true || "$value" == false ]] || die "Expected true or false";;
    CLOUD_GOOGLE_PLAY_PACKAGE)
      [[ "$value" =~ ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$ ]] || die "Invalid package";;
    *) die "Unsupported configuration key";;
  esac
  python3 - "$ENVFILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
file=Path(sys.argv[1]); key=sys.argv[2]; value=sys.argv[3]
lines=[row for row in file.read_text().splitlines() if not row.startswith(key+"=")]
file.write_text("\n".join(lines+[key+"="+value])+"\n")
file.chmod(0o600)
PY
  log "Updated $key. Apply using: spdecode restart web"
}
admin_password(){
  # Python scrypt parameters exactly match Next.js C6 settings.
  python3 - "$ENVFILE" <<'PY'
import getpass, hashlib, pathlib, secrets, sys
file=pathlib.Path(sys.argv[1])
password=getpass.getpass("New admin password (>=16 characters): ")
confirm=getpass.getpass("Confirm admin password: ")
if len(password)<16 or len(password)>512 or password!=confirm:
    raise SystemExit("Password invalid, too short, or confirmation differs")
salt=secrets.token_bytes(16)
digest=hashlib.scrypt(password.encode(),salt=salt,n=16384,r=8,p=1,dklen=64,maxmem=32*1024*1024)
hashed="scrypt$16384$8$1$"+salt.hex()+"$"+digest.hex()
rows=[x for x in file.read_text().splitlines() if not x.startswith("CLOUD_ADMIN_PASSWORD_SCRYPT=")]
file.write_text("\n".join(rows+["CLOUD_ADMIN_PASSWORD_SCRYPT='"+hashed+"'"])+"\n")
file.chmod(0o600)
print("Admin password hash stored (password not printed)")
PY
}
google_account(){
  [[ -f "$1" && $(stat -c %a "$1") =~ ^(400|600)$ ]] || die "Service account must be a file with chmod 600"
  python3 - "$ENVFILE" "$1" <<'PY'
import json,sys
from pathlib import Path
out=Path(sys.argv[1]); data=json.loads(Path(sys.argv[2]).read_text())
if data.get("type")!="service_account" or not data.get("private_key") or not data.get("client_email"):
    raise SystemExit("Invalid Google service account JSON")
serialized=json.dumps(data,separators=(",",":"))
if "'" in serialized:raise SystemExit("Unsupported quote in JSON")
rows=[x for x in out.read_text().splitlines() if not x.startswith("CLOUD_GOOGLE_SERVICE_ACCOUNT_JSON=")]
out.write_text("\n".join(rows+["CLOUD_GOOGLE_SERVICE_ACCOUNT_JSON='"+serialized+"'"])+"\n")
out.chmod(0o600)
print("Service account stored privately (not printed)")
PY
}
case "${1:-help}" in
 status)
   preflight; log "Source $(git -C "$REPO" rev-parse --short HEAD)"
   compose ps
   health && log "HTTP health OK" || log "HTTP health DOWN"
   ;;
 logs)
   case "${2:-}" in api|web|panel) compose logs --no-color --tail 120 web;;
     worker|engines) compose logs --no-color --tail 120 decoder-worker;;
     all) compose logs --no-color --tail 120 web decoder-worker;;
     *) die "spdecode logs api|web|panel|worker|all";; esac;;
 update)
   [[ $# -ge 2 ]] || die "spdecode update api|web|panel|worker|all [ref]"
   if [[ "$2" == app ]]; then
     ref="$SPDECODE_REF"
     shift 2
     if (($#)) && [[ "$1" != --* ]]; then ref="$1";shift;fi
     sync_ref "$ref"
     exec bash "$REPO/cloud/infra/vps/android-build.sh" build "$@"
   fi
   update "$2" "${3:-$SPDECODE_REF}";;
 restart)
   case "${2:-}" in
     api|web|panel) compose up -d --no-deps --force-recreate web;health;;
     worker|engines) compose up -d --no-deps --force-recreate decoder-worker;;
     all) compose up -d --force-recreate;health;;
     *) die "spdecode restart api|web|panel|worker|all";; esac;;
 backup)
   mkdir -p "$ROOT/backups"; stamp=$(date -u +%Y%m%dT%H%M%SZ)
   cp -p "$ENVFILE" "$ROOT/backups/cloud-$stamp.env"
   cp -p "$CONF" "$ROOT/backups/source-$stamp.conf"
   git -C "$REPO" rev-parse HEAD > "$ROOT/backups/commit-$stamp.txt"
   chmod 600 "$ROOT/backups/"*"$stamp"*
   log "Sensitive backup saved at $ROOT/backups; copy off-VPS encrypted";;
 rollback)
   preflight
   [[ -f "$ROOT/previous.sha" ]] || die "No rollback SHA"
   old=$(cat "$ROOT/previous.sha")
   [[ "$old" =~ ^[0-9a-f]{40}$ ]] || die "Bad rollback SHA"
   clean_repo;git -C "$REPO" cat-file -e "$old^{commit}"
   git -C "$REPO" reset --hard "$old"
   deploy all;;
 config)
   case "${2:-}" in
     set) [[ $# -eq 4 ]] || die "spdecode config set KEY VALUE";set_env "$3" "$4";;
     google-service-account) [[ $# -eq 3 ]] || die "spdecode config google-service-account /root/key.json";google_account "$3";;
     admin-password) [[ $# -eq 2 ]] || die "spdecode config admin-password";admin_password;;
     *) die "spdecode config set KEY VALUE | google-service-account FILE | admin-password";; esac;;
 android) shift;exec bash "$REPO/cloud/infra/vps/android-build.sh" "$@";;
 help|-h|--help)
   cat <<'USAGE'
SP-DECODE VPS commands:
  spdecode status
  spdecode logs api|web|panel|worker|all
  spdecode update api|web|panel|worker|all [branch/tag/SHA]
  spdecode update app [branch] --version-name X.Y.Z --version-code N --testing-only
  spdecode restart api|web|panel|worker|all
  spdecode rollback
  spdecode backup
  spdecode config set CLOUD_FORCE_MAINTENANCE true|false
  spdecode config set CLOUD_API_ENABLED true|false
  spdecode config set CLOUD_ADMIN_ENABLED true|false
  spdecode config google-service-account /root/play-service.json
  spdecode config admin-password
  spdecode android setup
  spdecode android signing configure /root/upload-key.p12 alias
  spdecode android build --version-name 1.2.0 --version-code 26 --testing-only
  spdecode android artifacts
USAGE
   ;;
 *) die "Unknown command; use spdecode help";;
esac
